# Copy to .env and adjust as needed. Never commit .env.

# --- LLM provider ---
# Provider: "auto" (default) picks the first available in order: ollama -> gemini -> groq.
# Or force one: "ollama", "gemini", "groq".
LLM_PROVIDER=auto
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2

# --- Gemini (hosted; free key from https://aistudio.google.com/app/apikey) ---
# GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-3.5-flash-lite
# --- Groq (hosted alternative; free key from https://console.groq.com) ---
# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=llama-3.3-70b-versatile

# Set to false on free hosts (no browser) — URL scraping falls back to HTTP + manual paste.
ENABLE_PLAYWRIGHT=true
# Thinking/reasoning traces make qwen3 ~40x slower for structured output.
# Keep false unless you specifically need chain-of-thought.
LLM_REASONING=false
# Optional Ollama tuning (leave unset for model defaults):
# LLM_NUM_CTX=8192
# LLM_NUM_PREDICT=2048
# Max characters of a JD sent to the LLM (scraped pages can be very long):
MAX_JD_CHARS=12000

# --- Resume constraints ---
MAX_PAGES=2
MAX_RETRIES=2

# --- Paths (defaults are relative to project root) ---
# STORAGE_DIR=storage
# OUTPUTS_DIR=outputs
# FORMATTING_CONFIG=config/formatting.yaml

# --- Logging ---
LOG_LEVEL=INFO
