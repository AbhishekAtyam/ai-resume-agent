# Streamlit Community Cloud secrets (see DEPLOY.md).
# In the Cloud dashboard: App → Settings → Secrets → paste these (with your real key).
# Streamlit exports secrets as environment variables, which the app reads via settings.
# DO NOT commit a real secrets.toml — it is git-ignored.

# "auto" picks the first available provider (ollama -> gemini -> groq). On the cloud
# there's no Ollama, so it will use Gemini (or Groq) from the key below.
LLM_PROVIDER = "auto"

# --- Gemini (recommended free; key from https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY = "your_gemini_key_here"
GEMINI_MODEL = "gemini-3.8-flash"

# --- Groq (optional alternative; key from https://console.groq.com) ---
# GROQ_API_KEY = "gsk_your_key_here"
# GROQ_MODEL = "llama-3.3-70b-versatile"

ENABLE_PLAYWRIGHT = "false"   # free hosts have no browser
LLM_REASONING = "false"
